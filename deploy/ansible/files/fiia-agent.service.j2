[Unit]
Description=Fiia agent - configuration drift detection
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=notify
User={{ fiia_user }}
ExecStart={{ fiia_install_dir }}/fiia-agent -config {{ fiia_config_dir }}/agent.toml
Restart=on-failure
RestartSec=30
{% if fiia_otlp_endpoint is defined and fiia_otlp_endpoint %}
Environment=OTEL_EXPORTER_OTLP_ENDPOINT={{ fiia_otlp_endpoint }}
{% endif %}

CPUQuota=10%
MemoryMax=256M
IOReadBandwidthMax=/ 512K
IOWriteBandwidthMax=/ 512K
Nice=19
IOSchedulingClass=idle

WatchdogSec=120

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ fiia_log_dir }}
PrivateTmp=true
CapabilityBoundingSet=

StandardOutput=append:{{ fiia_log_dir }}/agent.log
StandardError=append:{{ fiia_log_dir }}/agent.log

[Install]
WantedBy=multi-user.target
