[agent]
node_id             = "{{ inventory_hostname }}"
manifest_path       = "{{ fiia_config_dir }}/manifest.json"
heartbeat_interval_sec = {{ fiia_heartbeat_interval_sec }}
audit_interval_sec    = {{ fiia_audit_interval_sec }}
audit_jitter_max_sec  = {{ fiia_audit_jitter_max_sec }}
# otlp_endpoint = "http://otelcol.example.com:4318"  # omit for stdout export
# !!! WARNING !!!
# remediate = false   # OFF by default. Only enforces packages & services in the
#                     # manifest snapshot — does NOT restore users, cron,
#                     # firewall, sysctl, or other Ansible-managed state.
#                     # Re-running the provisioning playbook is the complete fix.
