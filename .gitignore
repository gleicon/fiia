# Binaries
fiia-agent
fiia-agent-*
fiia-hub
fiia-hub-*

# Go build cache
/vendor/

# Dev-generated certs and keys (regenerated by make dev-certs)
dev/ca/
dev/*.pem

# Dev backend config (machine-specific, written by make dev-setup)
dev/.backend

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Queue data
/var/lib/fiia/queue/

# Dev runtime output
dev/agent.log
dev/drift.log

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo

# Test output
*.test
coverage.out

# Generated dev inventory (make dev-inventory)
deploy/ansible/inventory/dev.ini

# E2E collector output (./e2e/run.sh)
e2e/out/

# Ansible E2E agent binary (built by e2e/ansible/run.sh)
e2e/ansible/bin/

# Ansible E2E collection staging symlink (built by run.sh)
e2e/ansible/collections/

# systemd E2E agent binary + collection staging (built by run.sh)
e2e/systemd/bin/
e2e/systemd/collections/
